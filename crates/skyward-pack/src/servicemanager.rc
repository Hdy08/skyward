# Older stock recoveries have no service directory or policy for the
# installed system's HALs. These settings apply only to recovery's RAM.
on early-init
    write /sys/fs/selinux/enforce 0

on post-fs
    # The stock board script aliases the modem image here. Keep the
    # installed vendor's own touch firmware visible after it is mounted.
    # Modem images remain available under /vendor/firmware_mnt and /firmware.
    umount /vendor/firmware

on boot
    setprop sys.usb.config adb

service servicemanager /system/bin/servicemanager
    user system
    group system readproc
    disabled
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /apex/com.android.runtime/lib64/bionic:/mnt/system/system/lib64/bootstrap:/mnt/system/system/lib64:/mnt/system_ext/lib64
